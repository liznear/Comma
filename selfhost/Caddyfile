:8080 {
    handle /source.tar.gz {
        root * /srv
        file_server
    }
    handle /LICENSE {
        root * /srv
        file_server
    }
    handle {
        root * /srv/web
        try_files {path} /index.html
        file_server
    }
}

:8081 {
    # Managed-OAuth browser callbacks (github, google, ...) live on the
    # salix endpoint (4000), not the product API (4200).
    handle /v1/oauth/* {
        reverse_proxy comma:4000
    }
    reverse_proxy comma:4200 {
        flush_interval -1
    }
}

:8082 {
    @source path /source.tar.gz /LICENSE
    handle @source {
        root * /srv
        file_server
    }
    handle /v1/* {
        respond "Use the configured API origin" 404
    }
    handle {
        root * /srv/admin
        try_files {path} /index.html
        file_server
    }
}
